# Environment Variables for Detooz Backend
# IMPORTANT: Never commit this file to git!

# AI API Keys
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Security
SECRET_KEY=generate_a_random_32_char_string_here

# Firebase (base64 encoded service account JSON)
FIREBASE_CREDENTIALS_BASE64=paste_your_base64_encoded_credentials_here

# Optional: Override database URL (default: SQLite in /data)
# DATABASE_URL=postgresql://user:pass@localhost:5432/detooz
