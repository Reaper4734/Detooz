# =============================================
# DETOOZ - Single Source of Truth .gitignore
# =============================================

# ---- Secrets & Keys ----
.env
**/.env
.env.*
*.pem
detooz-key.pem
firebase-service-account.json
**/firebase-service-account.json
google-services.json
**/google-services.json
key.properties
**/*.keystore
**/*.jks

# ---- CI/CD scripts (local paths) ----
deploy.ps1
pull.ps1
run_local.ps1
DEV_SCRIPTS_README.md
detooz_scripts.zip

# ---- Python ----
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
**/venv/
.venv/
dist/

# ---- Node ----
node_modules/

# ---- Logs ----
logs/
**/logs/
*.log

# ---- Databases (Local) ----
*.db
*.sqlite

# ---- OS ----
.DS_Store
Thumbs.db

# ---- IDE ----
.idea/
.vscode/
*.swp
*.swo

# ---- Build outputs ----
build/
app/build/
.dart_tool/
app/.dart_tool/

# ---- Large ML files (exceed GitHub limits) ----
backend/results/
results/
**/results/
backend/ml_pipeline/saved_model/model.safetensors
*.safetensors
backend/redis/
backend/ml_pipeline/data/
**/data/*.csv
**/data/*.jsonl
**/data/*.txt
**/data/*.parquet

# ---- Uploads (runtime data, not code) ----
backend/app/static/uploads/

# ---- Debug & temp files ----
app/build_log.txt
app/errors.txt
app/errors_ascii.txt
app/analysis_results.txt
app/doctor.txt
temp_file_list.txt
git_tracked.txt
git_status.txt
